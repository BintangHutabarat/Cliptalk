#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

# Clone baru: siapkan .env, dependensi, aset, dan tabel supaya `docker compose up` langsung jalan.
if [ $# -eq 0 ] && [ -f /var/www/html/artisan ]; then
    cd /var/www/html
    as_sail() { gosu "${WWWUSER:-sail}" env HOME=/home/sail "$@"; }

    if [ ! -f .env ]; then
        as_sail cp .env.example .env
        NEW_ENV=1
    fi

    [ -f vendor/autoload.php ] || as_sail composer install --no-interaction --prefer-dist
    [ -z "$NEW_ENV" ] || as_sail php artisan key:generate --force
    [ -f public/build/manifest.json ] || { as_sail npm ci && as_sail npm run build; }

    as_sail php artisan migrate --force --no-interaction
fi

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
